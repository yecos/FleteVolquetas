generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Volqueta {
  id            String   @id @default(cuid())
  placa         String   @unique
  marca         String
  modelo        String
  capacidadM3   Float
  capacidadTon  Float
  conductor     String
  estado        String   @default("disponible")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  viajes        Viaje[]
}

model Tarifa {
  id          String  @id @default(cuid())
  tipoVia     String  @unique
  precioBase  Float
  precioPorKm Float
  precioPorM3 Float
  activa      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Viaje {
  id           String   @id @default(cuid())
  volquetaId   String
  volqueta     Volqueta @relation(fields: [volquetaId], references: [id])
  origen       String
  destino      String
  distanciaKm  Float
  tipoVia      String
  tipoCargue   String
  metrosCubicos Float
  toneladas    Float?
  numViaje     Int?
  cliente      String?
  clienteId    String?
  clienteRef   Cliente? @relation(fields: [clienteId], references: [id])
  hrIni        String?
  hrFinal      String?
  klIni        Float?
  klFinal      Float?
  costoFlete   Float
  observaciones String?
  estadoPago   String   @default("pendiente")
  fecha        DateTime @default(now())
  estado       String   @default("pendiente")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pagos        Pago[]
}

model Cliente {
  id          String   @id @default(cuid())
  nombre      String
  documento   String?
  telefono    String?
  email       String?
  direccion   String?
  ciudad      String?
  notas       String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  viajes      Viaje[]
}

model Pago {
  id          String   @id @default(cuid())
  viajeId     String
  viaje       Viaje    @relation(fields: [viajeId], references: [id])
  monto       Float
  metodo      String
  referencia  String?
  fechaPago   DateTime @default(now())
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
